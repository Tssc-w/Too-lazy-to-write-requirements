{
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{web/**,templates/**}"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index.py?__vercel_path=/" },
    { "source": "/api/:path*", "destination": "/api/index.py?__vercel_path=/api/:path*" },
    { "source": "/:path*", "destination": "/api/index.py?__vercel_path=/:path*" }
  ]
}
